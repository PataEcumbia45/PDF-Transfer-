# Nombre comercial que aparece en la web, en la API y en los metadatos de los PDF.
APP_NAME=PDF Transfer
# Correo al que llegan las solicitudes de planes de pago (botón "Solicitar").
CONTACT_EMAIL=
# Claves de API de clientes de pago, separadas por comas: clave:plan (pro | business)
API_KEYS=
# Permitir imágenes remotas (http/https) en el Markdown. Mantener en false en un servicio público.
ALLOW_REMOTE_IMAGES=false
# Quitar todos los límites (uso personal o instalación interna).
DISABLE_LIMITS=false
# Dominios que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGINS=
# Modo IA: transcribe fórmulas complejas, PDF escaneados y escritura a mano con Claude.
# Se activa al poner una clave de https://console.anthropic.com (se cobra por uso).
ANTHROPIC_API_KEY=
# Modelo, esfuerzo (low | medium | high) y páginas en paralelo del Modo IA.
AI_MODEL=claude-opus-5
AI_EFFORT=medium
AI_CONCURRENCY=4
