# Configuración para usar PDF Transfer en tu propio computador.
# Los scripts "iniciar" la copian a .env la primera vez; para cambiar algo, edita .env.

# Sin límites de tamaño, páginas ni conversiones por hora (es para ti).
DISABLE_LIMITS=true

# Solo accesible desde este computador (http://localhost:8000).
HOST_BIND=127.0.0.1
APP_PORT=8000

# Modo IA (opcional): pega aquí tu clave de https://console.anthropic.com para transcribir
# fórmulas pegadas como imagen, PDF escaneados y escritura a mano. Tiene coste por uso.
ANTHROPIC_API_KEY=
